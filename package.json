{
  "name": "spotter",
  "version": "0.0.1",
  "description": "Your personal, transparent feed re-ranker. Finds the needles in the haystack.",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "node build-chrome.js",
    "build:firefox": "node build-firefox.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test test/*.ts",
    "eval": "tsx eval/run.ts",
    "fetch-corpus": "tsx eval/fetch-corpus.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.1.2",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
