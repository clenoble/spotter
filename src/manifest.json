{
  "manifest_version": 3,
  "name": "Spotter",
  "version": "0.0.1",
  "description": "Your personal, transparent feed re-ranker. Spots the needles in the haystack.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:11434/*",
    "http://localhost:8888/*",
    "https://api.openalex.org/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Spotter — open dashboard"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/feed/*", "https://www.linkedin.com/feed"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/dashboard/index.html"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
